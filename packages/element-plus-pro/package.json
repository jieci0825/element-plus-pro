{
    "name": "@jc/element-plus-pro",
    "version": "0.0.1",
    "description": "基于 Element Plus 二次封装的业务组件库",
    "keywords": [
        "element-plus-pro",
        "element",
        "vue3"
    ],
    "type": "module",
    "homepage": "https://github.com/jieci0825/element-plus-pro",
    "bugs": {
        "url": "https://github.com/jieci0825/element-plus-pro/issues"
    },
    "license": "MIT",
    "main": "es/index.mjs",
    "module": "es/index.mjs",
    "types": "es/index.d.ts",
    "exports": {
        ".": {
            "types": "./es/index.d.ts",
            "import": "./es/index.mjs",
            "require": "./lib/index.js"
        },
        "./global": {
            "types": "./global.d.ts"
        },
        "./es": {
            "types": "./es/index.d.ts",
            "import": "./es/index.mjs"
        },
        "./es/*.mjs": {
            "types": "./es/*.d.ts",
            "import": "./es/*.mjs"
        },
        "./es/*": {
            "types": [
                "./es/*.d.ts",
                "./es/*/index.d.ts"
            ],
            "import": "./es/*.mjs"
        },
        "./*": "./*"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jieci0825/element-plus-pro.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "style": "dist/index.css",
    "peerDependencies": {
        "element-plus": "^2.10.7",
        "vue": "^3.5.0"
    },
    "dependencies": {
        "dayjs": "^1.11.13"
    },
    "devDependencies": {
        "element-plus": "^2.10.7",
        "vue": "^3.5.18"
    },
    "web-types": "web-types.json",
    "browserslist": [
        "> 1%",
        "not ie 11",
        "not op_mini all"
    ]
}

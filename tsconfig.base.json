{
    "compilerOptions": {
        "outDir": "dist",
        "target": "es2018",
        "module": "esnext",
        "baseUrl": ".",
        "sourceMap": false,
        "moduleResolution": "node",
        "allowJs": false,
        "strict": true,
        "noUnusedLocals": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "removeComments": false,
        "rootDir": ".",
        "types": [],
        "paths": {
            "@coderjc/element-plus-pro-utils": ["packages/utils"],
            "@coderjc/element-plus-pro-constants": ["packages/constants"],
            "@coderjc/element-plus-pro-components": ["packages/components"],
            "@coderjc/element-plus-pro-components/*": ["packages/components/*"]
        },
        "preserveSymlinks": true
    }
}
